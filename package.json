{
  "name": "upi-qr-generator",
  "version": "1.0.0",
  "description": "Dynamic NPCI UPI QR Generator with PhonePe Gateway",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "@typescript/typescript6": "^6.0.2",
    "tsup": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
